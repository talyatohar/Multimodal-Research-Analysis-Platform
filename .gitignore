paper_values*
values_*.json
summary_*.json
*.log
logs/
outputs/
results/
cache/
*.ipynb
*.png
*.jpg
*.jpeg
*.gif
*.bmp

# --- The synthetic demo participant is the only exception ---
!/database/participants/participant_123456789/**
# (database/participants_table.xlsx stays tracked: the committed copy is demo-only)

# --- Documents: only the current manual is published ---
/docs/*
!/docs/manual/
/docs/manual/*
!/docs/manual/User_Manual_2026-11-23.docx
!/docs/manual/images/
!/docs/manual/images/*.png

# --- Internal notes in the project root ---
/HANDOFF.md
/PAPER_REVIEW.md
/*_section.txt
/_extract_*
/backend/analysis/eye_tracking/gap_reconstruction.py

